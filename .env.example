VITE_DATA_SOURCE=api
WASHGUARD_PGDATA=./.washguard/pgdata
WASHGUARD_ADMIN_EMAIL=
WASHGUARD_ADMIN_PASSWORD=
# Démonstration uniquement : renvoie le lien de réinitialisation dans la réponse
# HTTP de /api/auth/forgot-password (aucun e-mail n'est envoyé par ce serveur).
# DOIT rester vide hors sandbox : sinon n'importe qui peut réinitialiser le mot
# de passe d'un tiers et prendre le contrôle du compte.
WASHGUARD_DEMO_RESET=1
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=
VITE_SUPABASE_URL=
VITE_WG_TEST_AUTH=
