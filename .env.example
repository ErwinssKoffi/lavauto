VITE_DATA_SOURCE=api
WASHGUARD_PGDATA=./.washguard/pgdata
WASHGUARD_ADMIN_EMAIL=
WASHGUARD_ADMIN_PASSWORD=
WASHGUARD_SESSION_SECRET=
# Base publique des liens d'authentification (réinitialisation, confirmation).
WASHGUARD_PUBLIC_URL=
# 1 = renvoyer le lien de réinitialisation/confirmation dans la réponse HTTP.
# Refusé par défaut en production : un vrai expéditeur d'e-mail reste requis.
WASHGUARD_EXPOSE_AUTH_LINKS=
# 1 = exiger la confirmation d'e-mail avant la première connexion.
WASHGUARD_REQUIRE_EMAIL_CONFIRMATION=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=
VITE_SUPABASE_URL=
VITE_WG_TEST_AUTH=