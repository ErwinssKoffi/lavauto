{
  "name": "washguard",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "node scripts/lint.cjs",
    "check": "node scripts/check.cjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:ci": "npm run typecheck && npm run lint && npm run check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.8",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "postcss": "^8.4.16",
    "tailwindcss": "^3.1.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
